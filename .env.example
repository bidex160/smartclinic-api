NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=yournewmac
DATABASE_PASSWORD=
DATABASE_NAME=smartclinic

FRONTEND_URL=http://localhost:4200

# Required outside test. Use a high-entropy secret in each environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m

# Development only. This setting is ignored outside development and should remain false.
TYPEORM_SYNCHRONIZE=false
