NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=yournewmac
DATABASE_PASSWORD=
DATABASE_NAME=smartclinic

FRONTEND_URL=http://localhost:3500

# Required outside test. Use a high-entropy secret in each environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m

# Sequential provider-offer response window.
PROVIDER_OFFER_TTL_MINUTES=30
PROVIDER_INVITATION_TTL=604800
HEALTH_RESULT_ACCESS_TTL=604800

# Guided Self-Check AMBER analysis. Keep disabled unless an approved server-side
# OpenAI configuration is available. Never expose OPENAI_API_KEY to web clients.
GUIDED_SELF_CHECK_AI_PROVIDER=none
# OPENAI_API_KEY=replace-with-server-side-secret
# GUIDED_SELF_CHECK_OPENAI_MODEL=replace-with-approved-model-id
GUIDED_SELF_CHECK_OPENAI_TIMEOUT_MS=15000
GUIDED_SELF_CHECK_OPENAI_MAX_RETRIES=1
PROVIDER_INVITATION_FRONTEND_URL=http://localhost:3500/provider/setup

# Supported values: none, test (non-production capture only), resend.
EMAIL_PROVIDER=none
# Native push is disabled until server-side Firebase credentials are configured.
PUSH_PROVIDER=none
# Required only when PUSH_PROVIDER=firebase; keep these in server secret management.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
NOTIFICATION_PUSH_MAX_ATTEMPTS=5
# Browser (web) push. Generate a key pair once with `npx web-push generate-vapid-keys`
# and keep the private key in server secret management. Leave unset to disable.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:support@example.com
EMAIL_FROM_ADDRESS=no-reply@example.test
EMAIL_FROM_NAME=SmartClinic
EMAIL_SEND_TIMEOUT_MS=10000
# Required only when EMAIL_PROVIDER=resend. Store the real key in secret management.
RESEND_API_KEY=re_placeholder

PUBLIC_BOOKING_SESSION_TTL=604800
PUBLIC_BOOKING_COOKIE_SECURE=false
PUBLIC_BOOKING_COOKIE_SAME_SITE=lax
# PUBLIC_BOOKING_COOKIE_DOMAIN=

PAYMENT_PROVIDER=none
PAYMENT_VERIFICATION_MIN_INTERVAL_SECONDS=30
# Smart Prescription coordination fees are added transparently to the medicine/delivery total.
# 300 basis points = 3%. Caps use integer minor units (100000 NGN minor units = NGN 1,000).
PHARMACY_DOCTOR_COORDINATION_FEE_BPS=300
PHARMACY_HOSPITAL_COORDINATION_FEE_BPS=300
PHARMACY_DOCTOR_COORDINATION_FEE_CAP_MINOR=100000
PHARMACY_HOSPITAL_COORDINATION_FEE_CAP_MINOR=100000
PAYSTACK_SECRET_KEY=replace-with-server-side-secret-key
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
# PAYSTACK_PUBLIC_KEY=replace-with-public-key-if-needed-later
PAYSTACK_CALLBACK_URL=https://example.test/payment/callback
# PAYSTACK_PATIENT_CALLBACK_URL=https://example.test/my-health/payment/confirmation/
PAYSTACK_WEBHOOK_ENABLED=true

# OPay Online Cashier (select with PAYMENT_PROVIDER=opay)
# OPAY_BASE_URL=https://testapi.opaycheckout.com
# OPAY_MERCHANT_ID=replace-with-opay-merchant-id
# OPAY_PUBLIC_KEY=replace-with-opay-public-key
# OPAY_PRIVATE_KEY=replace-with-opay-private-key
# OPAY_CALLBACK_URL=https://example.test/api/v1/payments/opay/webhook
# OPAY_RETURN_URL=https://example.test/payment/callback
# OPAY_WEBHOOK_ENABLED=true

# Development only. This setting is ignored outside development and should remain false.
TYPEORM_SYNCHRONIZE=false

INITIAL_ADMIN_EMAIL=admin@smartclinicnetwork.com
INITIAL_ADMIN_PASSWORD=<strong-random-password>
INITIAL_ADMIN_NAME=SmartClinic Administrator

# Private Clinical Record attachments (disabled unless explicitly configured)
CLINICAL_ATTACHMENT_STORAGE_PROVIDER=none
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLINICAL_ATTACHMENT_ACCESS_TTL_SECONDS=300

WHATSAPP_ENABLED=true
WHATSAPP_META_ACCESS_TOKEN=...
WHATSAPP_META_PHONE_NUMBER_ID=...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=smartclinic-local-whatsapp-verify
WHATSAPP_META_APP_SECRET=...
WHATSAPP_META_GRAPH_API_VERSION=v23.0

# Staging-only acceptance identities. Keep real values in staging secret management.
# The seed also refuses to run while NODE_ENV=production.
CONFIRM_STAGING_ACCEPTANCE_SEED=
STAGING_E2E_PATIENT_EMAIL=
STAGING_E2E_PATIENT_PASSWORD=
STAGING_E2E_DOCTOR_EMAIL=
STAGING_E2E_DOCTOR_PASSWORD=
STAGING_E2E_PHARMACY_EMAIL=
STAGING_E2E_PHARMACY_PASSWORD=
STAGING_E2E_LAB_EMAIL=
STAGING_E2E_LAB_PASSWORD=
STAGING_E2E_RADIOLOGY_EMAIL=
STAGING_E2E_RADIOLOGY_PASSWORD=

# Share of a referred lab or pharmacy job paid to the provider who referred it,
# taken from the receiving provider's share (the patient's price does not change). 300 = 3%.
PROVIDER_REFERRAL_FEE_BPS=300

# Encrypts webhook signing secrets for hospital system integrations.
# Generate with: openssl rand -base64 32  (never commit the real value). Webhooks are off when empty.
INTEGRATION_ENCRYPTION_KEY=

# --- Companion (in-app guide) --------------------------------------------
# Smart answers in the person's language. Reuses OPENAI_API_KEY; "none" keeps the built-in answers only.
COMPANION_AI_PROVIDER=none
# COMPANION_OPENAI_MODEL=replace-with-approved-model-id
# Natural voices. Each is optional; languages without a key show text only (never a robotic voice).
# Spitch: Nigerian English, Pidgin, Yoruba, Hausa, Igbo  (https://spitch.app)
# SPITCH_API_KEY=
# COMPANION_SPITCH_PIDGIN_LANGUAGE=pcm
# Azure AI Speech: French, Swahili, East African English
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# GhanaNLP Khaya: Twi
# KHAYA_API_KEY=
# Last-resort voice for English/French via OpenAI (set true to allow)
# COMPANION_OPENAI_TTS=false
# Self-hosted Kinyarwanda voice (POST {text, language} -> audio)
# COMPANION_TTS_RW_URL=

# --- Wellness points toward Health Checks ---------------------------------
# Value of ONE point per currency (major units). 100 points = NGN 500 / GHS 4 / RWF 400.
WELLNESS_POINT_VALUES=NGN:5,GHS:0.04,RWF:4
WELLNESS_REDEEM_MAX_PERCENT=20
WELLNESS_REDEEM_MIN_POINTS=100

# --- Daily nudges ----------------------------------------------------------
# One gentle reminder a day (in-app + phone notification) at each person's chosen time.
NUDGES_ENABLED=true
# Optional WhatsApp copy. Needs a Meta-approved template whose body has {{1}} (title) and {{2}} (message),
# and WHATSAPP_ENABLED=true. Languages you created the template in, first = fallback.
# NUDGE_WHATSAPP_TEMPLATE=smartclinic_daily_nudge
# Facility outreach: WhatsApp invites go automatically once Meta approves this template
# (body: {{1}} facility name, {{2}} claim link). Until then staff send from their phone.
# FACILITY_INVITE_WHATSAPP_TEMPLATE=smartclinic_facility_invite
# Email reminders 2 and 7 days after an invite (default on).
# FACILITY_REMINDERS_ENABLED=true
# Claim codes over WhatsApp: a Meta "authentication" template (body {{1}} = code, copy-code button).
# FACILITY_CLAIM_CODE_WHATSAPP_TEMPLATE=smartclinic_claim_code
# Invite a facility automatically once this many patients have asked for it (hourly, capped).
# FACILITY_AUTO_INVITES_ENABLED=true
# FACILITY_AUTO_INVITE_MIN_DEMAND=3
# FACILITY_AUTO_INVITES_PER_HOUR=100

# Nigeria Health Facility Registry. Request a key at https://hfr.fmohconnect.gov.ng/developers.
# With a key set, the facility list refreshes itself every night (after 01:00 UTC).
# HFR_API_KEY=
# HFR_API_BASE_URL=https://backend.hfr.fmohconnect.gov.ng
# FACILITY_REGISTRY_SYNC_ENABLED=true

# Google Maps place IDs for "Reviews & directions" links. Optional: links work without it.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_HOURLY_LIMIT=200

# SMS for claim codes: termii or africastalking (test = log locally; never in production).
# SMS_PROVIDER=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=SmartClinic
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
# NUDGE_WHATSAPP_LANGUAGES=en,fr,sw
